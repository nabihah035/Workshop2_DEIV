<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="2dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="16dp">

        <!-- Main Evidence Info Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Verification Status Icon -->
            <ImageView
                android:id="@+id/ivVerified"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"
                app:srcCompat="@drawable/ic_verified"/>

            <!-- Evidence Details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="evidence_photo_001.jpg"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#000000"/>

                <TextView
                    android:id="@+id/tvEvidenceId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Evidence #1"
                    android:textSize="15sp"
                    android:textColor="#000000"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2024-01-15"
                    android:textSize="15sp"
                    android:textColor="#000000"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- Status Badge -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verified"
                android:textSize="12sp"
                android:textColor="#ffffff"
                android:background="@drawable/badge_verified"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"/>
        </LinearLayout>

        <!-- Metadata Section -->
        <LinearLayout
            android:id="@+id/metadataContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:paddingTop="12dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/metadata_bg"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvMetadataTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Metadata:"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#000000"
                android:layout_marginBottom="4dp"
                android:layout_marginLeft="2dp"/>

            <!-- Metadata items will be added programmatically -->
            <LinearLayout
                android:id="@+id/metadataItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:textSize="15sp"
                android:textColor="#000000"
                android:layout_marginLeft="2dp"/>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>