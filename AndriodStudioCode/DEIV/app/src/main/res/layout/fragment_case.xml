<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- Swipe to Refresh -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Main Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <!-- Folder Icon with Background -->
                <LinearLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/ic_folder_background"
                    android:gravity="center"
                    android:layout_marginEnd="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_folder"
                        android:tint="@android:color/white" />

                </LinearLayout>

                <!-- Case Management Text -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Case Management"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/black" />

                    <TextView
                        android:id="@+id/tvTotalCases"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4 total cases"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <!-- Add Button -->
                <ImageView
                    android:id="@+id/fabAddCase"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_add"
                    android:background="@drawable/add_button_background"
                    android:padding="12dp"
                    android:tint="@color/white"
                    android:contentDescription="Add Case"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- Search Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <!-- Search Bar -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/search_background"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:layout_marginEnd="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_search"
                        android:tint="#000000"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/etSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Search cases..."
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:background="@android:color/transparent"
                        android:maxLines="1"
                        android:imeOptions="actionSearch" />

                </LinearLayout>

                <!-- Filter Button -->
                <ImageView
                    android:id="@+id/btnFilter"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_filter"
                    android:background="@drawable/filter_background"
                    android:padding="12dp"
                    android:contentDescription="Filter"
                    android:tint="@color/black"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginTop="16dp" />

            <!-- Empty State -->
            <TextView
                android:id="@+id/tvNoCases"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No cases found.\nTap + to add a new case."
                android:textSize="16sp"
                android:textColor="#666666"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone" />

            <!-- Case List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerCases"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="0dp"
                android:visibility="visible" />

        </LinearLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>